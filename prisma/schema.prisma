// TrustLens Prisma schema (Prisma ORM 7)
// Core models are persistence models only; external/API payloads are
// validated separately with Zod. See context/trustlens-coding-standards.md.
//
// User/Session/Account/Verification are generated and kept in sync by the
// Better Auth CLI (`npx auth generate --config src/lib/auth.ts`); re-run it
// after changing src/lib/auth.ts instead of editing those models by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum ScanStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ScanStage {
  VALIDATION
  DNS_SECURITY_CHECKS
  DOMAIN_ANALYSIS
  TLS_ANALYSIS
  THREAT_INTELLIGENCE
  WEBSITE_ANALYSIS
  BRAND_ANALYSIS
  RISK_ANALYSIS
  REPORT_GENERATION
}

// A provider result is evidence, not the final TrustLens verdict.
enum ThreatResultStatus {
  MATCH
  NO_MATCH
  UNKNOWN
  ERROR
}

enum ArtifactType {
  SCREENSHOT
  HTML_CAPTURE
  BROWSER_CAPTURE
  OTHER
}

enum Verdict {
  LIKELY_SAFE
  LOW_RISK
  CAUTION
  SUSPICIOUS
  HIGH_RISK
  KNOWN_MALICIOUS
  IMPERSONATION
  INSUFFICIENT_EVIDENCE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  plan          Plan     @default(FREE)

  scans    Scan[]
  settings UserSettings?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  accounts  Account[]

  @@map("user")
}

model UserSettings {
  id          String  @id @default(cuid())
  userId      String  @unique
  theme       String  @default("system")
  emailAlerts Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scan {
  id     String @id @default(cuid())
  userId String

  submittedUrl  String @map("inputUrl")
  normalizedUrl String

  hostname         String
  normalizedDomain String  @map("rootDomain")
  subdomain        String?
  tld              String?

  status ScanStatus @default(QUEUED)
  // Null means a legacy scan has no recorded pipeline stage.
  stage  ScanStage? @default(VALIDATION)

  // Only user-safe descriptions belong here; never raw provider errors.
  failureCode    String?    @db.VarChar(64)
  failureMessage String?    @db.VarChar(256)
  failedStage    ScanStage?

  riskScore  Int?
  confidence Float?
  verdict    Verdict?

  riskEngineVersion String?
  scannerVersion    String?
  modelVersion      String?

  startedAt   DateTime?
  completedAt DateTime?

  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  domainProfileId String?
  domainProfile   DomainProfile?    @relation(fields: [domainProfileId], references: [id], onDelete: Restrict)
  dnsResults      DnsResult[]
  tlsResult       TlsResult?
  threatResults   ThreatResult[]
  snapshots       WebsiteSnapshot[]
  brandCandidates BrandCandidate[]
  findings        Finding[]
  aiAnalysis      AiAnalysis?
  report          Report?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domainProfileId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([normalizedDomain], map: "Scan_rootDomain_idx")
}

model DomainProfile {
  id                     String    @id @default(cuid())
  normalizedDomain       String    @map("domain")
  registrar              String?
  registrationDate       DateTime?
  expirationDate         DateTime?
  updatedDate            DateTime?
  domainAgeDays          Int?
  registrantOrganization String?
  registrantCountry      String?
  nameservers            String[]
  dnssec                 Boolean?
  status                 String[]
  source                 String
  retrievedAt            DateTime?

  scans Scan[]

  // Lookup a provider's most recent snapshot or reuse the exact observation.
  @@unique([normalizedDomain, source, retrievedAt])
}

model DnsResult {
  id          String    @id @default(cuid())
  scanId      String
  source      String
  retrievedAt DateTime?
  recordType  String
  value       String
  ttl         Int?
  priority    Int?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId, recordType, retrievedAt])
}

model TlsResult {
  id              String    @id @default(cuid())
  scanId          String    @unique
  source          String
  retrievedAt     DateTime?
  valid           Boolean
  issuer          String?
  subject         String?
  validFrom       DateTime?
  validTo         DateTime?
  hostnameMatches Boolean?
  sanEntries      String[]
  errors          String[]

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ThreatResult {
  id          String             @id @default(cuid())
  scanId      String
  provider    String
  // Retained for compatibility; null for UNKNOWN or ERROR.
  detected    Boolean?
  status      ThreatResultStatus @default(UNKNOWN)
  reference   String?
  categories  String[]
  confidence  Float?
  // Only minimal, non-sensitive provider metadata; never full responses.
  rawData     Json?
  retrievedAt DateTime           @map("checkedAt")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, provider])
}

model WebsiteSnapshot {
  // Null together for legacy page observations without a stored artifact.
  artifactType ArtifactType?
  r2ObjectKey  String?       @db.VarChar(1024)
  mimeType     String?       @db.VarChar(127)
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  expiresAt    DateTime?

  id              String   @id @default(cuid())
  scanId          String
  requestedUrl    String
  finalUrl        String?
  title           String?
  description     String?
  screenshotUrl   String?
  faviconUrl      String?
  statusCode      Int?
  redirects       Json?
  externalDomains String[]
  technologies    String[]
  htmlHash        String?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([expiresAt])
}

model BrandCandidate {
  id                String  @id @default(cuid())
  scanId            String
  brandName         String
  officialDomain    String?
  officialUrl       String?
  confidence        Float
  domainSimilarity  Float?
  textualSimilarity Float?
  visualSimilarity  Float?
  evidence          Json?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model Finding {
  id                String    @id @default(cuid())
  scanId            String
  type              String    @map("code")
  severity          Severity
  title             String
  description       String
  source            String
  evidence          Json?
  // Source-specific evidence key, provider reference, or internal artifact ID.
  evidenceReference String?
  scoreContribution Int?
  // Legacy creation times are unknown; new findings receive a timestamp.
  createdAt         DateTime? @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, severity])
}

model AiAnalysis {
  id           String @id @default(cuid())
  scanId       String @unique
  modelVersion String
  summary      String
  explanation  Json?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Report {
  id     String  @id @default(cuid())
  scanId String  @unique
  userId String?

  verdict    Verdict
  riskScore  Int
  confidence Float

  summary           String
  riskEngineVersion String
  modelVersion      String?

  generatedAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
